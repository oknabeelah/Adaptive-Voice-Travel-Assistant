# VoyceTrip Backend Configuration
# Copy this file to .env and add your actual credentials

# ElevenLabs API (for voice synthesis)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI API (for GPT intelligence)
OPENAI_API_KEY=your_openai_api_key_here

# Granola API (for context memory)
GRANOLA_API_KEY=your_granola_api_key_here

# Codewords Workflow (if using)
CODEWORDS_API_KEY=
CODEWORDS_WORKFLOW_ID=ai_travel_planner_ba4cd2f6

# Incident.io (for adaptive features)
INCIDENT_IO_API_KEY=your_incident_io_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here

# CORS Settings
ALLOWED_ORIGINS=http://localhost:*,https://yourdomain.com
